# Local publication inventory and packaging output may contain machine paths.
/Tools/Publication/audit.json
/Tools/Publication/rename_plan.json
/Tools/Publication/*_local.json
/Tools/Publication/publication.json

# Keep authored reference reports, not downloaded third-party checkouts.
/Tools/ReferenceAnalysis/*
!/Tools/ReferenceAnalysis/*.md
!/Tools/ReferenceAnalysis/repo_revisions.json

# Pipeline previews and screenshots are generated, not project source.
/Tools/**/*.png
/Tools/**/*.jpg
/Tools/**/*.jpeg
/Tools/**/*.gif
/Tools/**/*.mp4
/Tools/**/*.pdf

