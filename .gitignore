# Media is restored from the versioned source pack, never from Git history.
# Its .meta files stay tracked so Unity GUIDs remain stable.
/Assets/Recursos/**/*.png
/Assets/Recursos/**/*.jpg
/Assets/Recursos/**/*.jpeg
/Assets/Recursos/**/*.gif
