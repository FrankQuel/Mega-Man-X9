* text=auto
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf

# Preserve Unity serialized bytes and metadata exactly as packaged.
*.meta -text
*.unity -text
*.prefab -text
*.asset -text
*.mat -text
*.anim -text
*.controller -text
*.overrideController -text
*.renderTexture -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.zip binary
*.7z binary
*.pdf binary
